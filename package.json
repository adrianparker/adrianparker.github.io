{
  "name": "adrianparker.github.io",
  "version": "1.2.0",
  "description": "Personal website of Adrian Parker.",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:unit && SITE_STATS_FIXTURE=1 npm run build && mocha tests/*.test.mjs --timeout 60000",
    "test:unit": "c8 mocha 'tests/unit/**/*.test.mjs'",
    "test:smoke": "npm run build && mocha 'tests/smoke.test.mjs' --reporter spec",
    "test:visual": "SITE_STATS_FIXTURE=1 npm run build && mocha 'tests/visual-regression.test.mjs' --timeout 60000",
    "test:headless": "npm run build && mocha 'tests/smoke.test.mjs' --reporter spec",
    "lint:html": "html-validate $(find _site -name '*.html' -not -path '*/dist/*')",
    "build": "node --env-file-if-exists=.env node_modules/@11ty/eleventy/cmd.cjs",
    "photos": "node scripts/publish-photos.mjs",
    "new-gig": "node scripts/new-gig.mjs",
    "spellcheck": "node scripts/spellcheck.mjs",
    "stats:snapshot": "node --env-file-if-exists=.env scripts/site-stats-snapshot.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "serve": "node --env-file-if-exists=.env node_modules/@11ty/eleventy/cmd.cjs --serve",
    "start": "node --env-file-if-exists=.env node_modules/@11ty/eleventy/cmd.cjs --serve",
    "certs": "mkdir -p .certs && mkcert -cert-file .certs/localhost.pem -key-file .certs/localhost-key.pem localhost 127.0.0.1 ::1",
    "debug": "DEBUG=* npx eleventy",
    "test:theme": "SITE_STATS_FIXTURE=1 npm run build && mocha tests/theme.test.mjs --timeout 60000",
    "test:analytics": "npm run build && mocha tests/analytics.test.mjs --timeout 60000",
    "test:slideshow": "npm run build && mocha tests/slideshow.test.mjs --timeout 60000",
    "test:gighistory": "npm run build && mocha tests/gig-history.test.mjs --timeout 60000",
    "test:gighistory-setlist-review": "npm run build && mocha tests/gig-history-setlist-review.test.mjs --timeout 60000",
    "test:gighistory-filter-adaptation": "npm run build && mocha tests/gig-history-filter-adaptation.test.mjs --timeout 60000",
    "test:gighistory-stats-chart": "npm run build && mocha tests/gig-history-stats-chart.test.mjs --timeout 60000",
    "test:gighistory-stats-map": "npm run build && mocha tests/gig-history-stats-map.test.mjs --timeout 60000",
    "test:app-nav": "npm run build && mocha tests/app-nav.test.mjs --timeout 60000",
    "test:gig-post-setlist": "npm run build && mocha tests/gig-post-setlist.test.mjs --timeout 60000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adrianparker/adrianparker.github.io.git"
  },
  "author": "Adrian Parker",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/adrianparker/adrianparker.github.io/issues"
  },
  "homepage": "https://github.com/adrianparker/adrianparker.github.io#readme",
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-img": "^7.1.1",
    "@11ty/eleventy-plugin-rss": "^3.1.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "exifcmdline": "github:adrianparker/ExifCmdLine#v1.0.5",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "purecss": "^3.1.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.7",
    "diff": "^9.0.0",
    "nanoid": "^3.3.18"
  },
  "devDependencies": {
    "@cspell/dict-en-gb": "^5.0.38",
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "cheerio": "^1.2.0",
    "cspell": "^10.4.0",
    "cspell-lib": "^10.3.6",
    "html-validate": "^11.17.0",
    "mocha": "^12.0.3",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
