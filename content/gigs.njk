---
layout: base-layout.njk
title: Gigs
metadesc: Concert reviews by Adrian Parker - all gigs, most recent first.
permalink: /gigs/index.html
---
<div class="posts">
    <hr>

    {% for post in collections.gig | reverse %}

    <section>
        <h3>{{ post.data.date | readableDate }}</h3>
        <h1>{{ post.data.title }}</h1>
        <p class="blog-post-summary">
        {{ post.data.summary | safe }}
        </p>
            {{ post.page.excerpt | md | safe }}

            <a href="{{ post.page.url | url }}">Read more...</a>
    </section>
    <hr>

    {% endfor %}
</div>
