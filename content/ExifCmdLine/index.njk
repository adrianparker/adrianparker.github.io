{# app-layout provides the <main> landmark; this is just the app's grid wrapper #}
<div class="shell">
  <section class="panel">
    <h1>EXIF Viewer</h1>
    <p class="tagline">Browser only image metadata inspector.<br />Your file never leaves your computer.</p>

    <!-- [html-validate-disable-next wcag/h32 -- never submits; it groups controls the app JS reads directly. The prebuilt bundle looks up #exif-form and the app source is not in this repo, see #36] -->
    <form id="exif-form" class="controls">
      <label class="control-group">
        <span>Select image</span>
        <input id="file-input" type="file" accept="image/*" required />
      </label>

      <div id="drop-zone" class="drop-zone">
        Or drag and drop an image here
      </div>

      <label class="control-group">
        <span>Timezone adjustment (optional)</span>
        <select id="zone-input"></select>
      </label>

      <label class="toggle">
        <input id="all-input" type="checkbox" checked />
        <span>Include all EXIF fields (or just dates)</span>
      </label>

    </form>

    <p id="status" class="status" aria-live="polite"></p>
    <div id="selected-image-preview" class="selected-image-preview" hidden></div>
  </section>

  <section class="panel results-panel">
    <h2>Results</h2>
    <label class="control-group search-group">
      <span>Filter results</span>
      <input id="search-input" type="search" placeholder="e.g. GPS" />
    </label>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Key</th>
            <th>Value</th>
            <th id="zone-th" hidden>Zone</th>
          </tr>
        </thead>
        <tbody id="results-body"></tbody>
      </table>
    </div>
  </section>
</div>

{#
  The app itself was completely unmeasured. This hooks the page's own inputs
  rather than the bundle, whose source is not in this repo (#36).

  Only that a file was chosen and its rough size — never the filename, which
  people do put personal information in.
#}
<script>
    (function () {
        var input = document.getElementById('file-input');
        if (!input || !window.siteAnalytics) { return; }

        input.addEventListener('change', function () {
            var file = input.files && input.files[0];
            if (!file) { return; }
            window.siteAnalytics.capture('exif_file_loaded', {
                type: file.type || 'unknown',
                size_kb: Math.round(file.size / 1024)
            });
        });

        var dropZone = document.getElementById('drop-zone');
        if (dropZone) {
            dropZone.addEventListener('drop', function () {
                window.siteAnalytics.capture('exif_file_dropped');
            });
        }
    })();
</script>
