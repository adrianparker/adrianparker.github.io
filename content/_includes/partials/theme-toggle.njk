{#
  Theme toggle.

  Hidden until the inline head script adds `js` to <html>, so a reader without
  JavaScript never sees a control that cannot work.

  The label names the theme you will get by clicking, not the one you are in —
  the icon alone would be ambiguous, which is why there is visible text
  alongside it.
#}
{#
  The wrapper exists to align the button's left edge with the nav headings
  below it. Both are the same width and both are centred, so their left edges
  land in the same place.
#}
<div class="theme-toggle-wrap">
    <button type="button" class="theme-toggle" id="theme-toggle">
        <span class="theme-toggle-icon" aria-hidden="true"></span>
        <span class="theme-toggle-label">Theme</span>
    </button>
</div>

<script>
    (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');
        if (!btn) { return; }
        var label = btn.querySelector('.theme-toggle-label');
        var lightQuery = window.matchMedia('(prefers-color-scheme: light)');

        // The theme actually in effect: an explicit choice if there is one,
        // otherwise whatever the operating system asked for.
        function current() {
            return root.dataset.theme || (lightQuery.matches ? 'light' : 'dark');
        }

        function render() {
            var next = current() === 'dark' ? 'light' : 'dark';
            label.textContent = next === 'dark' ? 'Dark' : 'Light';
            btn.setAttribute('aria-label', 'Switch to ' + next + ' theme');
            btn.dataset.next = next;
        }

        btn.addEventListener('click', function () {
            var next = current() === 'dark' ? 'light' : 'dark';
            root.dataset.theme = next;
            try { localStorage.setItem('theme', next); } catch (e) { /* private mode */ }
            render();
        });

        // Follow the OS while the reader has not expressed a preference.
        lightQuery.addEventListener('change', function () {
            if (!root.dataset.theme) { render(); }
        });

        render();
    })();
</script>
