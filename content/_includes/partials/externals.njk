{#
  Renders site.externals. One source, two presentations:

    sidebarExternals()  desktop sidebar, as <li> inside the pure-menu list
    footerExternals()   mobile footer, as a flat list

  'kind' picks the link styling: "link" for plain external links, "rss" and
  "x" for the two that carry their own background icon.
#}

{% macro externalClass(kind) %}{% if kind == "rss" %}rss-button{% elif kind == "x" %}twitter-follow-button{% else %}pure-menu-link external-link{% endif %}{% endmacro %}

{#
  The "opens in new tab" marker is a decorative span inside the anchor, not a
  sibling <img>. Previously it sat outside the link — so it was not part of the
  click target — and carried alt="Opens in new tab", which a screen reader
  announced as a separate item after every one of the seven links.

  As a span it is also maskable, so it takes its colour from a token instead
  of the #666666 that used to be baked into the SVG.
#}
{% macro sidebarExternals(externals) %}
{%- for item in externals %}
<li class="pure-menu-item{% if item.kind != 'link' %} menu-item-spaced{% endif %}">
    <a href="{{ item.url }}" target="_blank" rel="nofollow" class="{{ externalClass(item.kind) | trim }}">{{ item.title }}<span class="external-link-icon" aria-hidden="true"></span></a>
</li>
{%- endfor %}
{% endmacro %}

{% macro footerExternals(externals) %}
<ul class="site-footer-list">
{%- for item in externals %}
    <li><a href="{{ item.url }}" target="_blank" rel="nofollow">{{ item.title }}</a></li>
{%- endfor %}
</ul>
{% endmacro %}
