<!DOCTYPE html>
<html lang="en">

    <head>
        {% include "partials/head.njk" %}
        {%- if appScript %}
        <script type="module" crossorigin src="{{ appScript }}"></script>
        {%- endif %}
        {% include "partials/analytics.njk" %}
    </head>

    <body class="app-page">
        <a class="skip-link" href="#main">Skip to content</a>

        {#
          App pages use the site sidebar at desktop width, the same as every
          other page, so the site navigates the same way wherever you are. It
          collapses to a rail for apps that want the width.

          Below the breakpoint the sidebar is hidden and app-nav.njk's bar and
          push-down sheet take over. Only one of the two is ever displayed, so
          a screen reader meets one nav.

          Nothing sits between the nav and the app: the app supplies its own
          <h1>.
        #}
        {% include "partials/app-nav.njk" %}
        {% set sidebarOnApp = true %}
        {% include "partials/sidebar.njk" %}

        <div class="app-column">
            <main id="main">
                {{ content | safe }}
            </main>

            {% include "partials/site-footer.njk" %}
        </div>
    </body>

</html>
