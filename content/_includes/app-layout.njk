<!DOCTYPE html>
<html lang="en">

    <head>
        {% include "partials/head.njk" %}
        {%- if appScript %}
        <script type="module" crossorigin src="{{ appScript }}"></script>
        {%- endif %}
        {% include "partials/analytics.njk" %}
    </head>

    <body class="app-page">
        <a class="skip-link" href="#main">Skip to content</a>

        {#
          App pages get the same left-hand navigation as the rest of the site,
          collapsed to a 60px rail on request — apps want the width, but the
          horizontal .app-bar this replaced put the nav somewhere it appeared
          nowhere else, so every app page navigated differently from every
          other page.

          The nav is the four sections only. The sidebar's sub-lists (recent
          posts, gigs, Elsewhere) stay off app pages; Elsewhere is in the
          footer, which app pages already render.

          Nothing sits between the nav and the app: the app supplies its own
          <h1>, and the way back out is the Apps link in the nav.
        #}
        {% include "partials/app-nav.njk" %}

        <div class="app-column">
            <main id="main">
                {{ content | safe }}
            </main>

            {% include "partials/site-footer.njk" %}
        </div>
    </body>

</html>
