---
layout: base-layout.njk
---
<div class="post">
    <article class="blog-post">
		<h1>{{ title }}</h1>
		<p class="entry-meta byline">By <a href="/about/" rel="author">Adrian Parker</a>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>{% if dateModified %}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Updated <time datetime="{{ dateModified | isoDate }}">{{ dateModified | readableDate }}</time>{% endif %}&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Reading time:&nbsp;{{ readingtime }}</p>
		{% if originallyPublished %}<p class="originally-published">Originally published on <a href="{{ originallyPublished }}">my old blog</a>.</p>{% endif %}
		<p class="blog-post-summary">
        {{ summary | safe }}
		</p>

        {{ content | safe }}

	</article>
</div>