<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="utf-8">
        <meta http-equiv="refresh" content="0; url={{ redirectTo }}">
        {#- No noindex: an instant meta refresh is already treated as a
            redirect, and noindex alongside it sends search engines mixed
            signals (#251). Stubs stay out of the sitemap instead. The
            canonical drops any #fragment, which canonicals cannot carry. #}
        <link rel="canonical" href="{{ redirectTo.split('#')[0] }}">
        <title>{{ title }}</title>
    </head>

    <body>
        <p>This page has moved to <a href="{{ redirectTo }}">{{ redirectTo }}</a>.</p>
    </body>

</html>
